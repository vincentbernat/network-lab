#!/bin/sh

# Boot a kernel built with ./build-kernel in a VM, load the routes and
# run the benchmark. This is ../bench-kernel without the build part.
#
# Usage: ./run-kernel VERSION OUTPUT DUMP...
#
# A dump is either the output of "ip route save" or, when its name ends
# with ".batch", a file for "ip -batch". When the name of the dump
# contains "32-", the lookups are done in 2.0.0.0-2.0.16.0. Otherwise,
# they are done in 0.0.0.0-223.255.255.255.
#
# Interfaces in the VM are lo (index 1), dummy0 (index 2), out1 to out5
# (index 3 to 7).
#
# Extra kernel parameters can be set with $KPARAMS. The VM runs on
# $VMCPU. $LOOPS is the number of lookups and $BATCH the number of
# lookups timed together. On AMD Zen, the TSC is increased by steps of
# 24 at 2.4 GHz, so a batch of 24 gives a resolution of one cycle.

set -e

BENCH=${BENCH:-/srv/bench}
V=$1
OUTPUT=$2
shift 2
BUILD=$BENCH/build/$V
VMCPU=${VMCPU:-4}
KPARAMS=${KPARAMS:-}
LOOPS=${LOOPS:-1000000}
BATCH=${BATCH:-24}

[ -f "$BUILD"/bzImage ] || {
    >&2 echo "$V is not built"
    exit 1
}

TMP=$(mktemp -d /tmp/run-kernel.XXXXXXXX)
trap "rm -rf $TMP" EXIT

cat <<'EOF' > ${TMP}/init
#!/bin/sh
set -ex
export PATH=/usr/local/bin:/usr/bin:/bin:/sbin:/usr/local/sbin:/usr/sbin
mount -n -t proc  proc /proc
mount -n -t sysfs sys /sys
mknod /dev/null c 1 3
mknod /dev/ttyS1 c 4 65
# busybox prefers its applets, use full path for iproute2
for i in 1 2 3 4 5; do
    /bin/ip link add name out$i type dummy
    /bin/ip link set up dev out$i
    /bin/ip addr add 203.0.113.$((i*2))/31 dev out$i
done
insmod /kbench_mod.ko
. /params
echo $LOOPS > /sys/kernel/kbench/loop_count
echo $BATCH > /sys/kernel/kbench/batch_count
cat /proc/version | tee /dev/ttyS1
cat /proc/cmdline | tee /dev/ttyS1
/bin/ip addr show
for f in /rtdump/*; do
  /bin/ip route flush scope global
  case $f in
    *.batch) /bin/ip -batch $f ;;
    *) /bin/ip route restore < $f ;;
  esac
  case ${f##*/} in
    *32-*)
      echo 2.0.0.0  > /sys/kernel/kbench/flow_dst_ipaddr_s
      echo 2.0.16.0 > /sys/kernel/kbench/flow_dst_ipaddr_e
      ;;
    *)
      echo 0.0.0.0         > /sys/kernel/kbench/flow_dst_ipaddr_s
      echo 223.255.255.255 > /sys/kernel/kbench/flow_dst_ipaddr_e
      ;;
  esac
  echo "### ${f##*/}" | tee /dev/ttyS1
  /bin/ip route show | wc -l | tee /dev/ttyS1
  sleep 2
  cat /sys/kernel/kbench/run_verbose | tee /dev/ttyS1
done
echo --- Guest > /dev/ttyS1
/bin/lscpu > /dev/ttyS1
grep . /sys/devices/system/cpu/vulnerabilities/* 2> /dev/null > /dev/ttyS1 || true
echo b > /proc/sysrq-trigger
EOF

# initrd
DESTDIR=$TMP/initrd
mkdir -p $DESTDIR
for bin in busybox ip lscpu; do
    install -D "$(command -v $bin)" ${DESTDIR}/bin/$bin
    for x in $(ldd "$(command -v $bin)" 2> /dev/null | sed -e '
               /\//!d;
               /linux-gate/d;
               /=>/ {s/.*=>[[:blank:]]*\([^[:blank:]]*\).*/\1/};
               s/[[:blank:]]*\([^[:blank:]]*\) (.*)/\1/' 2>/dev/null); do
        [ -f "${DESTDIR}/$x" ] || install -D "$x" "${DESTDIR}/$x"
    done
done
for applet in $(${DESTDIR}/bin/busybox --list); do
    [ -f ${DESTDIR}/bin/${applet} ] || ln -s busybox ${DESTDIR}/bin/${applet}
done
cp "$BUILD"/kbench_mod.ko ${DESTDIR}/kbench_mod.ko
cp ${TMP}/init ${DESTDIR}/init && chmod +x ${DESTDIR}/init
printf "LOOPS=%s\nBATCH=%s\n" $LOOPS $BATCH > ${DESTDIR}/params
mkdir -p ${DESTDIR}/rtdump
i=0
for f in "$@"; do
    i=$((i+1))
    cp "$f" ${DESTDIR}/rtdump/$i-${f##*/}
done
mkdir -p ${DESTDIR}/proc ${DESTDIR}/dev ${DESTDIR}/sys
(cd "${DESTDIR}" && find . | cpio --quiet -R 0:0 -o -H newc) | gzip -1 > $TMP/initrd.gz

timeout 600 taskset -c $VMCPU qemu-system-x86_64 \
    -enable-kvm \
    -nodefaults \
    -display none \
    -m 4096 \
    -smp 1 \
    -cpu host \
    -serial file:$TMP/console \
    -serial file:$TMP/output \
    -no-reboot \
    -kernel "$BUILD"/bzImage \
    -initrd $TMP/initrd.gz \
    -append "console=ttyS0 panic=1 oops=panic 8250.nr_uarts=4 $KPARAMS" || :

grep -q '^--- Guest' $TMP/output || {
    >&2 echo "run of $V failed, console in $OUTPUT.console"
    tail -30 $TMP/console >&2
    mkdir -p "$(dirname "$OUTPUT")"
    cp $TMP/console "$OUTPUT".console
    exit 1
}
(
    echo --- Host
    qemu-system-x86_64 --version
    cat "$BUILD"/compiler
    uname -a
    lscpu
    grep . /sys/devices/system/cpu/vulnerabilities/*
) >> ${TMP}/output
mkdir -p "$(dirname "$OUTPUT")"
cp ${TMP}/output "$OUTPUT"
